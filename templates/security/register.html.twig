{% extends 'base.html.twig' %}

{% block title %}Register - Toggl Report Generator{% endblock %}

{% block body %}
<div style="max-width: 400px; margin: 0 auto;">
    <h2 style="text-align: center; margin-bottom: 30px;">Register</h2>

    <form method="post" action="{{ path('app_register') }}">
        <div class="form-group">
            <label for="inputEmail">Email</label>
            <input type="email" name="email" id="inputEmail" required autofocus>
        </div>

        <div class="form-group">
            <label for="inputPassword">Password</label>
            <input type="password" name="password" id="inputPassword" required>
        </div>

        <div class="form-group">
            <label for="inputPasswordConfirm">Confirm Password</label>
            <input type="password" name="password_confirm" id="inputPasswordConfirm" required>
        </div>

        <button class="btn" type="submit" style="width: 100%;">Register</button>
    </form>

    <p style="text-align: center; margin-top: 20px;">
        Already have an account? <a href="{{ path('app_login') }}" style="color: #667eea;">Login here</a>
    </p>
</div>
{% endblock %}
