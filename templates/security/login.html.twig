{% extends 'base.html.twig' %}

{% block title %}Login - Toggl Report Generator{% endblock %}

{% block body %}
<div style="max-width: 400px; margin: 0 auto;">
    <h2 style="text-align: center; margin-bottom: 30px;">Login</h2>

    {% if error %}
        <div class="flash error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post">
        <div class="form-group">
            <label for="inputEmail">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" required autofocus>
        </div>

        <div class="form-group">
            <label for="inputPassword">Password</label>
            <input type="password" name="_password" id="inputPassword" required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn" type="submit" style="width: 100%;">Sign in</button>
    </form>

    <p style="text-align: center; margin-top: 20px;">
        Don't have an account? <a href="{{ path('app_register') }}" style="color: #667eea;">Register here</a>
    </p>
</div>
{% endblock %}
