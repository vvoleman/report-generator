<table>
    <thead>
        <tr>
            <th>Date</th>
            <th>Project</th>
            <th>Description</th>
            <th>Hours</th>
        </tr>
    </thead>
    <tbody>
        {% for entry in entries %}
            {% for detail in entry.entries %}
            <tr>
                <td>{{ entry.date }}</td>
                <td>{{ entry.project_name }}</td>
                <td>{{ detail.description }}</td>
                <td>{{ detail.hours }}</td>
            </tr>
            {% endfor %}
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3"><strong>Total</strong></td>
            <td><strong>{{ total_hours }}</strong></td>
        </tr>
    </tfoot>
</table>
