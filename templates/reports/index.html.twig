{% extends 'base.html.twig' %}

{% block title %}Generate Report - Toggl Report Generator{% endblock %}

{% block body %}
<h2>Generate Toggl Report</h2>

<div style="margin-top: 30px;">
    <form method="post" action="{{ path('app_reports_generate') }}" style="max-width: 600px;">
        <div class="form-group">
            <label for="month">Select Month</label>
            <input type="month" name="month" id="month" required value="{{ 'now'|date('Y-m') }}">
            <small style="color: #666; display: block; margin-top: 5px;">
                Choose the month for which you want to generate the report.
            </small>
        </div>

        <div class="form-group">
            <label for="template">Report Template</label>
            <select name="template" id="template" required>
                {% for label, value in templates %}
                    <option value="{{ value }}">{{ label }}</option>
                {% endfor %}
            </select>
            <small style="color: #666; display: block; margin-top: 5px;">
                Choose a template for your report layout.
            </small>
        </div>

        <div style="display: flex; gap: 10px;">
            <button type="submit" class="btn">Generate Report</button>
            <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </form>
</div>

<div style="margin-top: 40px; background: #f8f9fa; padding: 20px; border-radius: 10px;">
    <h3 style="margin-bottom: 15px;">About Report Templates</h3>
    <ul style="padding-left: 20px; line-height: 1.8;">
        <li><strong>Default:</strong> Shows time entries grouped by project and day with totals</li>
        <li><strong>Detailed:</strong> Includes individual entry descriptions and more granular data</li>
        <li><strong>Summary:</strong> Project-level aggregation only, perfect for quick overviews</li>
        <li><strong>Daily Summary:</strong> Lists all days in the month with total hours worked (weekends grayed out)</li>
    </ul>
</div>
{% endblock %}
